{
    "name": "flo-bezier3",
    "sideEffects": false,
    "description": "Purely functional linear, quadratic and cubic bezier library, including accurate, robust bezier intersection.",
    "version": "8.1.1",
    "author": {
        "name": "Floris Steenkamp"
    },
    "license": "MIT",
    "type": "module",
    "main": "./node/index.js",
    "exports": "./node/index.js",
    "engines": {
        "node": ">=22.0.0"
    },
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlorisSteenkamp/FloBezier.git"
    },
    "bugs": {
        "url": "https://github.com/FlorisSteenkamp/FloBezier/issues"
    },
    "keywords": [
        "bezier",
        "beziers",
        "quadratic",
        "cubic",
        "intersection"
    ],
    "dependencies": {
        "big-float-ts": "^4.0.4",
        "double-double": "^4.0.0",
        "flo-gauss-quadrature": "^2.1.4",
        "flo-graham-scan": "^4.0.2",
        "flo-poly": "^9.0.0",
        "flo-vector2d": "^4.0.6"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@swc/core": "^1.16.18",
        "@swc/jest": "^0.2.39",
        "@types/circular-dependency-plugin": "^5.0.8",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "c8": "^12.0.0",
        "circular-dependency-plugin": "^5.2.2",
        "jest": "^30.5.2",
        "jest-cli": "^30.5.2",
        "jest-ts-webcompat-resolver": "^1.0.1",
        "rimraf": "^6.1.3",
        "squares-rng": "^2.0.4",
        "typescript": "^7.0.2",
        "webpack": "^5.111.1",
        "webpack-bundle-analyzer": "^5.4.0",
        "webpack-cli": "^7.2.3"
    },
    "files": [
        "node",
        "browser",
        "src"
    ],
    "scripts": {
        "build": "npm run build-node && npm run build-browser",
        "build-node": "rimraf node && tsc",
        "build-browser": "webpack",
        "test": "jest",
        "coverage": "c8 jest"
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true,
        "@parcel/watcher@2.6.0": true,
        "@swc/core@1.16.18": true
    }
}
